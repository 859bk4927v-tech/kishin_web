{
  "name": "kishin-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build:static": "node scripts/render_static.mjs",
    "check:static": "node scripts/render_static.mjs --check",
    "test": "node --test tests/*.test.js",
    "dev": "wrangler dev --ip 0.0.0.0 --port 8000",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create kishin-bookings",
    "db:migrate:local": "wrangler d1 migrations apply kishin-bookings --local",
    "db:migrate:remote": "wrangler d1 migrations apply kishin-bookings --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260925.1": true
  }
}
