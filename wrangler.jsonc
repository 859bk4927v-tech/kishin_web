{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kishin-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/", "/index.html", "/robots.txt", "/sitemap.xml", "/page/*"]
  },
  "build": {
    "command": "npm run build:static",
    "watch_dir": ["public/js", "scripts"]
  },
  "d1_databases": [
    {
      "binding": "BOOKING_DB",
      "database_name": "kishin-bookings",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "BOOKING_DAYS_AHEAD": "60",
    "SITE_URL": ""
  }
}
