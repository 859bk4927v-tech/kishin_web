{
  // Start the local Worker, then open the site in Chrome. The server listens on LAN too.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Kishin: Run and Debugで起動（Chrome・iPhone確認）",
      "type": "node-terminal",
      "request": "launch",
      "command": "npx wrangler dev --ip 0.0.0.0 --port 8002 --inspector-port 9232",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "Ready on http://.*",
        "uriFormat": "http://127.0.0.1:8002/",
        "action": "openExternally"
      }
    }
  ]
}
