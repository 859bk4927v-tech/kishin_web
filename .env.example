# Copy this file to .env and replace ADMIN_TOKEN with a private random value.
# Do not commit .env or paste real credentials into chat.
ADMIN_TOKEN=replace-with-a-long-random-secret
BOOKING_DAYS_AHEAD=60
PORT=8000
HOST=127.0.0.1

# Leave blank until LINE Messaging API is ready.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_OWNER_USER_ID=
